; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="City Explorer - Gunslinger Prototype"
run/main_scene="res://game/levels/apartment/apartment.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Bindings="*res://autoload/bindings.gd"
Events="*res://autoload/events.gd"
DebugOverlay="*res://game/autoload/debug_overlay.gd"
CardLibrary="*res://game/autoload/card_library.gd"
GameState="*res://game/autoload/game_state.gd"
SaveService="*res://game/autoload/save_service.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighter"
3d_physics/layer_3="hurtbox"
3d_physics/layer_4="pickup"
3d_physics/layer_5="card_body"
3d_physics/layer_6="trigger"

[physics]

common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.15, 1)
