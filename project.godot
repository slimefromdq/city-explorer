; Engine configuration file.
config_version=5

[application]

config/name="City Explorer - Gunslinger Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Bindings="*res://autoload/bindings.gd"
Events="*res://autoload/events.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighter"
3d_physics/layer_3="hurtbox"
3d_physics/layer_4="pickup"

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.15, 1)
